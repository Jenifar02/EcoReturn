// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  password      String
  role          Role      @default(USER)
  walletAddress String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tokens        Token[]
  redemptions   Redemption[]
  scans         BottleScan[]
  shopProfile   ShopProfile?
}

enum Role {
  USER
  SHOP_OWNER
  ADMIN
}

model Token {
  id              String      @id @default(cuid())
  // ── Commit-Reveal fields ──────────────────────────────────────────
  // codeHash = SHA-256(plaintext_code + TOKEN_SECRET)
  // Plaintext code is NEVER stored. User sees it once on generation.
  codeHash        String      @unique   // stored commitment
  codePrefix      String                // e.g. "ECO-1" — lets user search by prefix, not full code
  // ─────────────────────────────────────────────────────────────────
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  totalBottles    Int
  totalAmount     Float                 // BDT
  status          TokenStatus @default(PENDING)
  blockchainHash  String?
  blockchainTx    String?
  createdAt       DateTime    @default(now())
  expiresAt       DateTime
  redeemedAt      DateTime?

  bottles         BottleScan[]
  redemption      Redemption?
}

enum TokenStatus {
  PENDING
  REDEEMED
  EXPIRED
}

model BottleScan {
  id             String   @id @default(cuid())
  barcode        String   @unique      // each barcode only once
  bottleType     String
  refundValue    Float
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  tokenId        String?
  token          Token?   @relation(fields: [tokenId], references: [id])
  scannedAt      DateTime @default(now())
  blockchainHash String?
}

model Redemption {
  id             String   @id @default(cuid())
  tokenId        String   @unique
  token          Token    @relation(fields: [tokenId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  shopId         String?
  shopProfile    ShopProfile? @relation(fields: [shopId], references: [id])
  amount         Float
  method         String   @default("cash")   // cash, bkash, nagad
  redeemedAt     DateTime @default(now())
  blockchainHash String?
}

// ── Shop Owner profile ────────────────────────────────────────────────
model ShopProfile {
  id          String        @id @default(cuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id])
  shopName    String
  area        String
  district    String
  phone       String
  status      ShopStatus    @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())

  redemptions Redemption[]
}

enum ShopStatus {
  PENDING
  APPROVED
  SUSPENDED
}

// ── Pre-registered Barcodes (Admin generates) ─────────────────────────
model RegisteredBarcode {
  id          String   @id @default(cuid())
  barcode     String   @unique     // EAN-13 or QR value
  bottleType  String               // "PET 500ml" | "PET 1L" | "Glass" | "Aluminium"
  refundValue Float                // BDT
  brand       String?
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  usedAt      DateTime?
}

model Location {
  id        String         @id @default(cuid())
  name      String
  area      String
  city      String
  district  String
  status    LocationStatus @default(ACTIVE)
  lat       Float?
  lng       Float?
}

enum LocationStatus {
  ACTIVE
  PLANNED
  INACTIVE
}

model BlockchainRecord {
  id          String   @id @default(cuid())
  entityType  String   // token | scan | redemption
  entityId    String
  txHash      String   @unique
  blockNumber Int?
  data        Json
  createdAt   DateTime @default(now())
}
